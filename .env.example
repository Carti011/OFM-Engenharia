# Envio da solicitação de orçamento (app/api/orcamento)
# Conta do Google Workspace da OFM. SMTP_SENHA é uma SENHA DE APP do Google,
# nunca a senha da conta — ela é revogável isoladamente.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=ofmengenharia@ofmengenharia.com.br
SMTP_SENHA=

# Destino das solicitações. Opcional — sem ela, usa fernando.franco@ofmengenharia.com.br
EMAIL_DESTINO_ORCAMENTO=

# Rótulo da ação de conversão do Google Ads, no formato AW-18425425968/AbCdEfGh123
# Sem ela, o pedido é enviado normalmente, mas nenhuma conversão é registrada.
NEXT_PUBLIC_ROTULO_CONVERSAO_ORCAMENTO=
